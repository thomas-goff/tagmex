# Supabase transaction pooler (the app) and session pooler (drizzle-kit migrations only)
DATABASE_URL=
MIGRATION_DATABASE_URL=
# 32+ chars; also in Supabase Vault as cron_secret
CRON_SECRET=

# Gmail (phase 1): Google Cloud "Desktop app" OAuth client, and the token from npm run gmail:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional, default notifyme@absa.co.za
GMAIL_SENDER=

# Clerk (phase 3): dashboard sign-in, and the MCP server's OAuth authorization server
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Discord, one webhook per channel. Only DISCORD_WEBHOOK_URL is required: the others fall back to it.
#   #transactions  each categorised transaction, with its category's budget this cycle
DISCORD_WEBHOOK_URL=
#   #needs-review  each uncategorised transaction, ticked off once categorised
DISCORD_REVIEW_WEBHOOK_URL=
#   #budget        daily digest, 80%/100% alerts, salary landed / overdue, cycle recap
DISCORD_BUDGET_WEBHOOK_URL=
#   #system        parse failures, sync / Gmail token failures, stale sync, heartbeat
DISCORD_SYSTEM_WEBHOOK_URL=
# Optional: your Discord user id, @-mentioned on critical #system messages only
DISCORD_PING_USER_ID=
# Optional: a public image URL, Pennyworth's avatar on every post
DISCORD_AVATAR_URL=
